# AI4 Contact Center — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# ─── Runtime flow authority ───────────────────────────────────────────────────
# Valid values: dev, qa, staging, production
# Non-production may use controlled fallbacks. Production requires an explicitly
# deployed canonical flow version for the tenant + channel + environment.
AI4CC_RUNTIME_ENVIRONMENT=dev

# ─── OpenAI (AI-powered parser) ───────────────────────────────────────────────
# If set, the builder uses GPT-4o-mini for parsing. Falls back to rule engine if missing.
OPENAI_API_KEY=

# ─── Supabase (auth + cloud flow storage) ─────────────────────────────────────
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Twilio (voice webhook auth) ──────────────────────────────────────────────
# Used to validate the X-Twilio-Signature on incoming Twilio webhooks.
TWILIO_AUTH_TOKEN=

# ─── ElevenLabs voice agents ──────────────────────────────────────────────────
# Sales Specialist agent (routes +17253305102 via /api/twilio/twiml?profile=sales)
ELEVENLABS_SALES_AGENT_ID=

# Support Specialist agent (still routed via TWILIO_BRIDGE_WS_URL for now)
# ELEVENLABS_SUPPORT_AGENT_ID=

# ─── Bridge (support profile — existing OpenAI-based agent) ───────────────────
TWILIO_BRIDGE_WS_URL=
BRIDGE_HMAC_SECRET=

# ─── Legacy intake fallback (Apropos Group LLC demo tenant) ───────────────────
# Set to false to require the x-ai4cc-intake-key header on all webhook calls.
AI4CC_INTAKE_ALLOW_UNKEYED=true
AI4CC_INTAKE_FALLBACK_ACTOR_ID=
