{
  "version": "1.0",
  "thresholds": {
    "high": 0.9,
    "medium": 0.7,
    "rule": 0.94,
    "ambiguous": 0.78,
    "unknown": 0.3
  },
  "availabilityMaxAgeHours": 24,
  "scoreDisclaimer": "Rule scores are conservative routing heuristics, not calibrated probabilities. A model score never conveys authorization.",
  "scopeNote": "platform_tenant_id and the legacy tenant_id both mean the existing owner workspace; residents remain contacts/occupancies.",
  "modelFields": [
    "topic",
    "bedrooms",
    "move_date",
    "impact",
    "category",
    "description",
    "safety_indicators",
    "response",
    "vendor_status",
    "notes",
    "followup_requested"
  ],
  "canonicalFields": [
    "intent",
    "confidence",
    "channel",
    "platform_tenant_id",
    "property_id",
    "unit_id",
    "contact_role",
    "contact_id",
    "tenant_id",
    "prospect_id",
    "workflow_action",
    "priority",
    "requires_clarification",
    "requires_escalation",
    "requires_notification",
    "safety_override",
    "knowledge_entry_ids",
    "correlation_id",
    "timestamp"
  ],
  "intents": [
    {
      "id": "INT-001",
      "intent": "LEASING_INQUIRY",
      "agent": "Leasing Agent",
      "workflow": "WF-001 Leasing Inquiry",
      "action": "leasing",
      "required": [
        "property"
      ],
      "pattern": "tell me about the property|how much is rent|leasing|amenities",
      "examples": [
        "What units do you have?",
        "Tell me about the property.",
        "How much is rent?"
      ],
      "restrictions": "No guaranteed availability or pricing.",
      "safety": false,
      "legacy": "leasing_inquiry"
    },
    {
      "id": "INT-002",
      "intent": "UNIT_AVAILABILITY",
      "agent": "Leasing Agent",
      "workflow": "Availability Lookup",
      "action": "availability",
      "required": [
        "property",
        "unit_preference",
        "move_date"
      ],
      "pattern": "available|availability|bedrooms?|next opening",
      "examples": [
        "Do you have a two-bedroom?",
        "When is the next opening?"
      ],
      "restrictions": "Use only fresh authoritative inventory; never guarantee availability.",
      "safety": false,
      "legacy": "leasing_inquiry"
    },
    {
      "id": "INT-003",
      "intent": "SHOWING_REQUEST",
      "agent": "Leasing Agent",
      "workflow": "WF-002 Showing Request",
      "action": "showing",
      "required": [
        "property",
        "prospect_name",
        "contact_method",
        "showing_time"
      ],
      "pattern": "showing|tour|see the unit|visit the (unit|property)",
      "examples": [
        "Can I see the unit?",
        "Schedule a showing."
      ],
      "restrictions": "Requested times are not confirmed until the workflow/calendar confirms them.",
      "safety": false,
      "legacy": "showing_request"
    },
    {
      "id": "INT-004",
      "intent": "APPLICATION_QUESTION",
      "agent": "Leasing Agent",
      "workflow": "Application Question Workflow",
      "action": "knowledge",
      "required": [
        "property",
        "topic"
      ],
      "pattern": "apply|applying|application|what is the fee",
      "examples": [
        "How do I apply?",
        "What is the fee?"
      ],
      "restrictions": "No screening, applicant approval/rejection or legal determination.",
      "safety": false,
      "legacy": "policy_question"
    },
    {
