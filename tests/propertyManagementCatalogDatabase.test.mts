import test from 'node:test';
import assert from 'node:assert/strict';
import {readFileSync,readdirSync} from 'node:fs';
import {createRequire} from 'node:module';
import {PGlite} from '@electric-sql/pglite';
const require=createRequire(import.meta.url),runtime=require('../twilio-bridge/pma-intents.cjs');
const t='20000000-0000-4000-8000-000000000001',p='40000000-0000-4000-8000-000000000001',c='30000000-0000-4000-8000-000000000001',u='50000000-0000-4000-8000-000000000001';
const owner='10000000-0000-4000-8000-000000000001',vend='10000000-0000-4000-8000-000000000005';
test('catalog database enforces every intent, scope, confidence, replay, audit and authority gate',async ctx=>{
 const db=new PGlite();try{
 await db.exec(readFileSync('supabase/tests/pma_local_baseline.sql','utf8'));
 for(const f of readdirSync('supabase/migrations').filter(f=>f.includes('_pma_')).sort())await db.exec(readFileSync('supabase/migrations/'+f,'utf8'));
 const config=await db.query<{v:unknown}>('select private.pm_catalog_config() v');assert.deepEqual(config.rows[0].v,runtime.config);
 await db.exec(readFileSync('supabase/tests/pma_acceptance.sql','utf8').split('set local role authenticated;')[0]);
 await db.exec(`update public.ai4cc_contacts set email='synthetic@example.invalid',phone='+12025550199' where tenant_id='${t}';update public.pm_properties set accepts_inquiries=true where id='${p}';insert into public.pm_units(tenant_id,property_id,label,bedrooms,status)values('${t}','${p}','Fresh vacancy',2,'vacant');insert into public.pm_maintenance_requests(id,tenant_id,property_id,unit_id,contact_id,summary,idempotency_key)values('70000000-0000-4000-8000-000000000010','${t}','${p}','${u}','${c}','Catalog fixture','catalog-fixture');`);
 const auth=async(id:string,role='authenticated')=>{await db.exec('set local role '+role);await db.query("select set_config('request.jwt.claims',$1,true)",[JSON.stringify({sub:id,role:'authenticated'})]);};
 const denied=async(fn:()=>Promise<unknown>)=>{await db.exec('savepoint expected_denial');try{await assert.rejects(fn);}finally{await db.exec('rollback to savepoint expected_denial; release savepoint expected_denial');}};
 await auth(owner);
 const assigned=await db.query<{v:any}>('select public.pm_assign_vendor($1,$2,$3,$4) v',[t,p,'70000000-0000-4000-8000-000000000010','60000000-0000-4000-8000-000000000001']);
 const assignment=await db.query<{id:string}>('select id from public.pm_vendor_assignments where tenant_id=$1',[t]);const aid=assignment.rows[0].id;
 const call=async(name:string,key:string,options:any={})=>{const msg=options.message??runtime.byName[name].examples[0],decision=runtime.classify(msg,options.proposal);const d={intent:decision.intent,confidence:decision.confidence,confidence_source:decision.confidence_source,entities:{...decision.entities,bedrooms:2,move_date:'2099-01-01',impact:'Reported impact',...options.entities}};return (await db.query<{v:any}>('select public.pm_catalog_turn($1,$2,$3,$4,$5,$6,$7,$8::jsonb,$9,$10,$11,$12::jsonb) v',[options.t??t,options.p===undefined?p:options.p,options.c===undefined?c:options.c,options.u===undefined?u:options.u,key,options.channel??'chat',msg,JSON.stringify(d),options.confirmed??true,options.showingAt===undefined?new Date(Date.now()+86400000).toISOString():options.showingAt,options.requestId??'70000000-0000-4000-8000-000000000010',JSON.stringify(options.w??{})])).rows[0].v;};
 for(const def of runtime.config.intents)await ctx.test(def.intent,async()=>{
  let opts:any={};await auth(owner);
  if(def.action.startsWith('vendor')){await auth(vend);opts={c:'30000000-0000-4000-8000-000000000002',u:null,w:{assignmentId:aid,...(def.action==='vendor_response'?{response:'accepted'}:{status:'in_progress'})}};}
  if(def.action==='owner_override'){const req=await db.query<{version:number}>('select version from public.pm_maintenance_requests where id=$1',['70000000-0000-4000-8000-000000000010']);opts.w={action:'priority',requestId:'70000000-0000-4000-8000-000000000010',version:req.rows[0].version,priority:'high'};}
  const out=await call(def.intent,'catalog-case-'+def.id,opts);
  assert.equal(out.intent,def.intent);for(const f of runtime.config.canonicalFields)assert.ok(Object.hasOwn(out,f),f);
  assert.equal(out.persisted,true);assert.equal(out.notificationSent,false);assert.ok(out.correlation_id);assert.equal(out.platform_tenant_id,t);assert.notEqual(out.workflow_action,'clarify');
  if(def.safety){assert.equal(out.safety_override,true);assert.equal(out.escalation_level,'critical');assert.equal(out.emergencyServicesContacted,false);}
  if(['unknown','lease'].includes(def.action))assert.ok(out.followupTaskId);
 });
 await auth(owner);
 await ctx.test('medium/low confidence and greetings create no lead or maintenance record',async()=>{
  await db.exec('reset role');
  const before=await db.query<{leads:number;requests:number;tasks:number}>(`select (select count(*) from public.ai4cc_leads)::int leads,(select count(*) from public.pm_maintenance_requests)::int requests,(select count(*) from public.automation_tasks)::int tasks`);
  await auth(owner);
  const medium=await call('MAINTENANCE_REQUEST','catalog-medium-01',{message:'Routine question',proposal:{intent:'MAINTENANCE_REQUEST',confidence:0.7}});assert.equal(medium.workflow_action,'clarify');assert.equal((medium.reply.match(/\?/g)??[]).length<=1,true);
  const low=await call('MAINTENANCE_REQUEST','catalog-low-01',{message:'Unclear need',proposal:{intent:'MAINTENANCE_REQUEST',confidence:0.1}});assert.equal(low.intent,'UNKNOWN_QUESTION');assert.ok(low.followupTaskId);
  await call('GENERAL_GREETING','catalog-greeting-02',{p:null,c:null,u:null});
  await db.exec('reset role');
  const after=await db.query<{leads:number;requests:number;tasks:number}>(`select (select count(*) from public.ai4cc_leads)::int leads,(select count(*) from public.pm_maintenance_requests)::int requests,(select count(*) from public.automation_tasks)::int tasks`);
  assert.equal(after.rows[0].leads,before.rows[0].leads);assert.equal(after.rows[0].requests,before.rows[0].requests);assert.equal(after.rows[0].tasks,before.rows[0].tasks+1);await auth(owner);
 });
 await ctx.test('replay is stable and changed operations conflict',async()=>{const a=await call('HELP_REQUEST','catalog-replay-01',{showingAt:null}),b=await call('HELP_REQUEST','catalog-replay-01',{showingAt:null});assert.equal(a.correlation_id,b.correlation_id);assert.equal(b.replayed,true);await denied(()=>call('GENERAL_GREETING','catalog-replay-01',{showingAt:null}));});
 await ctx.test('missing required entities clarify without action and balance questions escalate',async()=>{const missing=await call('MAINTENANCE_REQUEST','catalog-missing-01',{u:null});assert.equal(missing.workflow_action,'clarify');assert.equal(missing.requestId,undefined);const pay=await call('PAYMENT_QUESTION','catalog-payment-02',{message:'Was my payment received?'});assert.equal(pay.requires_escalation,true);assert.ok(pay.followupTaskId);assert.equal(pay.balance,undefined);});
 await ctx.test('cross-owner and staff cross-property access is denied',async()=>{await denied(()=>call('OWNER_REQUEST','catalog-cross-owner',{t:'20000000-0000-4000-8000-000000000002',p:'40000000-0000-4000-8000-000000000003',c:null,u:null}));await auth('10000000-0000-4000-8000-000000000003');await denied(()=>call('HELP_REQUEST','catalog-cross-property',{p:'40000000-0000-4000-8000-000000000002',u:null}));const result=await call('OWNER_REQUEST','catalog-not-owner');assert.equal(result.workflow_action,'authorization_required');assert.equal(result.summary,undefined);await auth(owner);});
 await ctx.test('owner changes require confirmation and stale versions are rejected',async()=>{const out=await call('OWNER_OVERRIDE','catalog-unconfirmed',{confirmed:false,w:{action:'priority',requestId:'70000000-0000-4000-8000-000000000010',version:1,priority:'emergency'}});assert.equal(out.workflow_action,'clarify');await denied(()=>call('OWNER_OVERRIDE','catalog-stale-version',{w:{action:'priority',requestId:'70000000-0000-4000-8000-000000000010',version:1,priority:'emergency'}}));});
 await ctx.test('native residents can retrieve only their own status and approved knowledge is sourced',async()=>{await auth('10000000-0000-4000-8000-000000000004');const out=await call('MAINTENANCE_STATUS','catalog-resident-status');assert.ok(out.reply.includes('Assigned'));await denied(()=>call('MAINTENANCE_STATUS','catalog-other-contact',{c:'30000000-0000-4000-8000-000000000002'}));await auth(owner);await db.exec(`insert into public.ai4cc_knowledge_entries(tenant_id,property_id,title,content,visibility,approved,source_status,publication_state)values('${t}','${p}','parkingprobe','parkingprobe approved directions','resident',true,'VERIFIED','published')`);const kb=await call('PARKING_QUESTION','catalog-kb-source',{message:'parkingprobe',proposal:{intent:'PARKING_QUESTION',confidence:0.95}});assert.equal(kb.knowledge_entry_ids.length,1);assert.ok(kb.reply.includes('approved directions'));});
 await ctx.test('trusted service actors cannot acquire owner authority',async()=>{await auth(owner,'service_role');const decision={intent:'OWNER_REQUEST',confidence:1,entities:{}};const out=(await db.query<{v:any}>('select public.pm_trusted_catalog_turn($1,$2,$3,$4,$5,$6,$7,$8,$9::jsonb) v',[owner,t,p,c,u,'catalog-service-owner','voice','Show open requests.',JSON.stringify(decision)])).rows[0].v;assert.equal(out.workflow_action,'authorization_required');assert.equal(out.summary,undefined);await auth(owner);});
 await ctx.test('database safety override wins over an unknown model and missing routine context',async()=>{const out=await call('UNKNOWN_QUESTION','catalog-safety-override',{message:'I smell gas.',proposal:{intent:'GENERAL_GREETING',confidence:0.1},p:null,c:null,u:null});assert.equal(out.intent,'SUSPECTED_GAS_LEAK');assert.equal(out.safety_override,true);assert.ok(out.reply.includes('safe'));assert.ok(out.followupTaskId);});
 await ctx.test('uncertain model safety reports cannot become routine priority',async()=>{const out=await call('PERSONAL_SAFETY_THREAT','catalog-model-safety',{message:'Something dangerous is happening',proposal:{intent:'PERSONAL_SAFETY_THREAT',confidence:0.5},p:null,c:null,u:null});assert.equal(out.intent,'PERSONAL_SAFETY_THREAT');assert.equal(out.confidence,0.5);assert.equal(out.priority,'emergency');assert.equal(out.safety_override,true);assert.equal(out.confidence_source,'model_proposal');assert.ok(out.followupTaskId);});
 await ctx.test('audit records contain correlations, sources and outcomes; public legacy bypass is revoked',async()=>{const rows=await db.query<{details:any}>("select details from public.audit_log where action='pma.intent.routed'");assert.ok(rows.rows.length>=25);for(const {details} of rows.rows){assert.ok(details.correlation_id);assert.ok(details.resolution);assert.ok(Array.isArray(details.knowledge_entry_ids));}const grants=await db.query<{allowed:boolean}>("select has_function_privilege('authenticated','public.pm_record_channel_turn(uuid,uuid,uuid,uuid,text,text,text,text,text,text,timestamptz,uuid)','execute') allowed");assert.equal(grants.rows[0].allowed,false);});
 await db.exec('rollback');
 }finally{await db.close();}
});
